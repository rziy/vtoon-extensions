{
  "manifest_version": 3,
  "name": "VoraToon Discord Presence",
  "version": "3.0.0",
  "description": "Detect manga/manhwa title + chapter on VoraToon and send it to a local Discord Rich Presence bridge.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.voratoon.com/*",
    "http://127.0.0.1:1738/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.voratoon.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VoraToon Presence",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
